{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truyenqq-adblock/rules.schema.json",
  "title": "Ad-block rules (data only, no code)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "site", "network", "cosmetic", "script"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-\\d+$" },

    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "hostRegex"],
      "properties": {
        "hosts": { "$ref": "#/$defs/domainList", "minItems": 1 },
        "hostRegex": { "type": "string", "maxLength": 200 }
      }
    },

    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockDomains", "blockUrlFilters", "thirdPartyAllowlist", "protectedHosts"],
      "properties": {
        "blockDomains": { "$ref": "#/$defs/domainList" },
        "thirdPartyAllowlist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "frameHosts"],
          "properties": {
            "enabled": { "type": "boolean" },
            "frameHosts": { "$ref": "#/$defs/domainList" }
          }
        },
        "protectedHosts": { "$ref": "#/$defs/domainList", "minItems": 1 },
        "blockUrlFilters": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]+$", "maxLength": 200 }
        }
      }
    },

    "cosmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hideSelectors", "zIndexThreshold"],
      "properties": {
        "hideSelectors": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 200, "pattern": "^[^{}<>;]+$" }
        },
        "zIndexThreshold": { "type": "integer", "minimum": 100000, "maximum": 2147483647 }
      }
    },

    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockInlineScripts", "stripFallbackHandlers", "guardWindowOpen", "guardClickHijack", "allowedScriptHosts", "allowedOpenHosts"],
      "properties": {
        "blockInlineScripts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "textIncludesAny"],
            "properties": {
              "name": { "type": "string", "maxLength": 50 },
              "attrs": {
                "type": "object",
                "maxProperties": 5,
                "additionalProperties": { "type": "string", "maxLength": 100 }
              },
              "textIncludesAny": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": { "type": "string", "minLength": 4, "maxLength": 100 }
              }
            }
          }
        },
        "stripFallbackHandlers": { "type": "boolean" },
        "guardWindowOpen": { "type": "boolean" },
        "guardClickHijack": { "type": "boolean" },
        "allowedScriptHosts": { "$ref": "#/$defs/domainList", "minItems": 1 },
        "allowedOpenHosts": { "$ref": "#/$defs/domainList", "minItems": 1 }
      }
    }
  },

  "$defs": {
    "domainList": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 253,
        "pattern": "^(?!-)[a-z0-9-]+(\\.[a-z0-9-]+)+$"
      }
    }
  }
}
