{
  "manifest_version": 3,
  "name": "QQ Clean Reader",
  "version": "0.3.0",
  "description": "Blocks gambling ads and redirects on TruyenQQ.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "scripting"],
  "host_permissions": ["*://*.truyenqqko.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "QQ Clean Reader",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.truyenqqko.com/*"],
      "js": ["src/defaults.js", "src/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.truyenqqko.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "qq-clean-reader@ducpham1512", "strict_min_version": "128.0" }
  }
}
