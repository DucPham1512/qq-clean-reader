{
  "manifest_version": 3,
  "name": "QQ Clean Reader",
  "version": "0.3.2",
  "description": "Blocks gambling ads and redirects on TruyenQQ.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "scripting"],
  "host_permissions": ["*://*.truyenqqko.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "QQ Clean Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.truyenqqko.com/*"],
      "js": ["src/defaults.js", "src/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.truyenqqko.com/*"],
      "js": ["src/defaults.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qq-clean-reader@ducpham1512.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
